    {
      "description": "Persist and read a reference request through AgentDb.",
      "idempotency": "inherent",
      "input_schema": {
        "additionalProperties": false,
        "description": "Existing typed request or one bounded canonical plain-text instruction.",
        "oneOf": [
          {
            "not": {
              "required": [
                "instruction"
              ]
            },
            "required": [
              "request_id",
              "description"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "request_id"
                  ]
                },
                {
                  "required": [
                    "description"
                  ]
                }
              ]
            },
            "required": [
              "instruction"
            ]
          }
        ],
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instruction"
          },
          "request_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          }
        },
        "title": "PersistRequestInput",
        "type": "object"
      },
      "metadata": null,
      "name": "persist_reference_request",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "object_id": {
            "title": "Object Id",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "root_artifact_id": {
            "title": "Root Artifact Id",
            "type": "string"
          },
          "root_sha256": {
            "title": "Root Sha256",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "request_id",
          "description",
          "status",
          "revision",
          "root_artifact_id",
          "root_sha256"
        ],
        "title": "PersistRequestOutput",
        "type": "object"
      },
      "required_capabilities": [],
      "requires_approval": false,
      "risk": "write"
    },
    {
      "description": "Discover an offer and request it through the escrow.",
