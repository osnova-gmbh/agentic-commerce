{
  "description": "E -> buyer, seller. Signed receipt; head_seq and head_hash name the deal head it attests.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "settled",
        "refunded"
      ]
    },
    "price_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000000000000
    },
    "fee_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000000000000
    },
    "payout_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000000000000
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR"
      ]
    },
    "terms_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "Lower-case hex SHA-256"
    },
    "head_seq": {
      "type": "integer",
      "minimum": 1
    },
    "head_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "Lower-case hex SHA-256"
    }
  },
  "required": [
    "outcome",
    "price_minor",
    "fee_minor",
    "payout_minor",
    "currency",
    "terms_hash",
    "head_seq",
    "head_hash"
  ],
  "additionalProperties": false
}
