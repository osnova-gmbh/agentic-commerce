FROM ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa AS uv
FROM python:3.11.16-slim-bookworm@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84 AS builder

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY . /app
RUN find /app/src -type f -exec chmod 0644 {} + \
    && python scripts/verify_framework_wheels.py \
    && uv lock --check \
    && uv sync --frozen --no-dev --extra workspace --no-editable \
    && uv pip check \
    && uv build --wheel --out-dir /app/.agent-wheel \
    && uv pip install --python /app/.venv/bin/python --reinstall --no-deps /app/.agent-wheel/*.whl \
    && .venv/bin/python -I scripts/verify_installed_packages.py --agent-wheel-dir /app/.agent-wheel

FROM python:3.11.16-slim-bookworm@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84 AS workspace
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/cogit-browsers \
    UV_PYTHON_DOWNLOADS=never
RUN apt-get update \
    && apt-get install --no-install-recommends -y git ca-certificates \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 agent \
    && mkdir -p /workspace /automation /run/cogit \
    && chown agent:agent /workspace /automation /run/cogit
WORKDIR /workspace
USER agent
# Run with --init (Compose init:true) to reap owned browser descendants.
# Mount the published manifest/cohort read-only; credentials are host-injected.
CMD ["python", "-I", "-m", "cogit_runtime", "work", "--manifest", "/run/cogit/cogit.yaml"]
